generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PRODUCT_MANAGER
  CONTENT_MANAGER
  ORDER_MANAGER
}

enum ProductStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  DRAFT
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum RecipeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum CustomerStatus {
  ACTIVE
  DISABLED
  BLOCKED
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum UgcStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum FeedbackCategory {
  GENERAL_INQUIRY
  PRODUCT_QUESTION
  RECIPE_QUESTION
  WEBSITE_FEEDBACK
  COMPLAINT
  BUSINESS_INQUIRY
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum BannerPlacement {
  HOME_HERO
  HOME_PROMO
  PRODUCTS_TOP
  PREORDER
  GLOBAL_NOTICE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  BRAND_ASSET
  EXTERNAL
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  RECIPE_VIEW
  SEARCH
  SEARCH_NO_RESULT
  ADD_TO_CART
  WISHLIST_ADD
  WHATSAPP_CLICK
  PREORDER_CLICK
}

enum NotificationType {
  NEW_CUSTOMER
  NEW_REVIEW
  REVIEW_AWAITING_MODERATION
  NEW_PREORDER
  PRODUCT_SCHEDULED
  PRODUCT_PUBLISHED
  NEW_CUSTOMER_COOKING_SUBMISSION
  LOW_STOCK
  NEW_ORDER
  FAILED_PAYMENT
  SECURITY_EVENT
  ADMIN_ACCOUNT_CHANGE
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  username     String?        @unique
  displayName  String?
  phone        String?
  profilePhoto String?
  bio          String?
  passwordHash String
  role         Role           @default(PRODUCT_MANAGER)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  twoFactorEnabled Boolean    @default(false)
  twoFactorPending Boolean    @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model AdminSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  categoryId       String
  imagePath        String
  price            Decimal?      @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2)
  preparationTime  String?
  servings         String?
  featured         Boolean       @default(false)
  pinned           Boolean       @default(false)
  preorder         Boolean       @default(false)
  preorderMessage  String?
  expectedDispatch String?
  status           ProductStatus @default(DRAFT)
  publishAt        DateTime?
  unpublishAt      DateTime?
  sortOrder        Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews          Review[]
  recipes          Recipe[]

  @@index([categoryId])
  @@index([status, publishAt, unpublishAt])
  @@index([pinned, featured, sortOrder])
}

model Recipe {
  id String @id @default(cuid())
  title String
  slug String @unique
  shortDescription String?
  description String?
  productId String?
  imagePath String?
  videoUrl String?
  preparationTime String?
  cookingTime String?
  servings String?
  difficulty String?
  ingredients Json
  instructions Json
  category String?
  featured Boolean @default(false)
  pinned Boolean @default(false)
  status RecipeStatus @default(DRAFT)
  publishAt DateTime?
  unpublishAt DateTime?
  sortOrder Int @default(0)
  seoTitle String?
  seoDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
  @@index([status,publishAt,unpublishAt])
  @@index([pinned,featured,sortOrder])
  @@index([productId,status])
}

model SiteSettings {
  id String @id @default("site")
  businessName String @default("Vijaya Premix")
  brandDescription String @default("Ready-to-cook Indian premixes for convenient home cooking.")
  phone String?
  email String?
  address String?
  whatsappNumber String?
  whatsappMessage String?
  instagramUrl String?
  facebookUrl String?
  youtubeUrl String?
  defaultSiteTitle String @default("Vijaya Premix | Ready-to-Cook Indian Premixes")
  defaultMetaDescription String @default("Ready-to-cook Indian premixes from Vijaya Premix.")
  defaultOgImage String @default("/assets/images/brand/vijaya-premix-logo.jpeg")
  aboutHeading String @default("Authentic flavour. Less kitchen hassle.")
  aboutDescription String @default("Vijaya Premix makes ready-to-cook Indian premixes for convenient home cooking.")
  mission String?
  vision String?
  promiseText String @default("Original branded pack artwork, honest product information, and convenient home cooking.")
  updatedAt DateTime @updatedAt
}

model HomepageSettings {
  id String @id @default("homepage")
  heroEyebrow String?
  heroHeading String @default("Cook Delicious. Cook Instantly.")
  heroDescription String @default("Authentic flavours without the kitchen hassle.")
  heroCtaLabel String @default("Shop Premixes")
  heroCtaUrl String @default("/products")
  heroProductId String?
  showOffer Boolean @default(false)
  showCategories Boolean @default(true)
  showProducts Boolean @default(true)
  showPromise Boolean @default(true)
  showPackToPlate Boolean @default(true)
  showRecipeVideo Boolean @default(true)
  showReviews Boolean @default(true)
  showPreorder Boolean @default(true)
  showGallery Boolean @default(false)
  showNewsletter Boolean @default(false)
  promiseHeading String @default("Our Promise")
  promiseDescription String @default("Authentic flavour made convenient for your kitchen.")
  promiseItems Json @default("[]")
  packToPlateItems Json @default("[]")
  updatedAt DateTime @updatedAt
}

model Review {
  id           String       @id @default(cuid())
  customerName String
  customerId   String?
  rating       Int
  content      String
  productId    String?
  status       ReviewStatus @default(DRAFT)
  featured     Boolean      @default(false)
  pinned       Boolean      @default(false)
  moderationNotes String?
  publishAt    DateTime?
  unpublishAt  DateTime?
  sortOrder    Int          @default(0)
  reviewDate   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, publishAt, unpublishAt])
  @@index([pinned, featured, sortOrder])
  @@index([productId, status])
}

model Customer {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?
  passwordHash String?
  status    CustomerStatus @default(ACTIVE)
  statusReason String?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]
  activities CustomerActivity[]
  ugc       UserGeneratedContent[]
  sessions  CustomerSession[]

  @@index([status, createdAt])
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model AuthThrottle {
  id           String   @id @default(cuid())
  scope        String
  keyHash      String
  attempts     Int      @default(0)
  windowStart  DateTime @default(now())
  blockedUntil DateTime?
  lastAttemptAt DateTime @default(now())

  @@unique([scope, keyHash])
  @@index([blockedUntil])
}

model CustomerActivity {
  id         String   @id @default(cuid())
  customerId String?
  type       String
  summary    String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([type, createdAt])
}

model UserGeneratedContent {
  id        String   @id @default(cuid())
  customerId String?
  imagePath String?
  caption   String?
  productId String?
  recipeId  String?
  status    UgcStatus @default(PENDING)
  featured  Boolean @default(false)
  pinned    Boolean @default(false)
  moderationNotes String?
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, featured, pinned])
  @@index([submittedAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  url       String
  type      MediaType
  altText   String?
  width     Int?
  height    Int?
  sizeBytes Int?
  provider  String @default("local-or-external")
  usageNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, createdAt])
}

model Banner {
  id        String @id @default(cuid())
  title     String
  subtitle  String?
  imagePath String?
  ctaLabel  String?
  ctaUrl    String?
  placement BannerPlacement
  status    ContentStatus @default(DRAFT)
  featured  Boolean @default(false)
  pinned    Boolean @default(false)
  publishAt DateTime?
  unpublishAt DateTime?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, status, publishAt, unpublishAt])
  @@index([pinned, featured, sortOrder])
}

model Feedback {
  id        String @id @default(cuid())
  name      String?
  email     String?
  phone     String?
  category  FeedbackCategory @default(GENERAL_INQUIRY)
  status    FeedbackStatus @default(NEW)
  subject   String
  message   String
  internalNotes String?
  assignedToId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, category, createdAt])
}

model Notification {
  id        String @id @default(cuid())
  userId    String?
  type      NotificationType
  title     String
  message   String?
  entityType String?
  entityId   String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
}

model AnalyticsEvent {
  id        String @id @default(cuid())
  type      AnalyticsEventType
  productId String?
  recipeId  String?
  searchQuery String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([productId, createdAt])
  @@index([recipeId, createdAt])
}

model AuditLog {
  id        String @id @default(cuid())
  adminId   String?
  action    String
  entityType String
  entityId   String?
  summary    String
  changes    Json?
  createdAt  DateTime @default(now())
  admin      User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
