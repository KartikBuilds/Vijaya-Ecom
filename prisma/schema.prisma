generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(ADMIN)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  categoryId       String
  imagePath        String
  price            Decimal?      @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2)
  preparationTime  String?
  servings         String?
  featured         Boolean       @default(false)
  preorder         Boolean       @default(false)
  status           ProductStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews          Review[]
  recipes          Recipe[]

  @@index([categoryId])
  @@index([status, sortOrder])
}

model Recipe {
  id String @id @default(cuid())
  title String
  slug String @unique
  shortDescription String?
  description String?
  productId String?
  imagePath String?
  videoUrl String?
  preparationTime String?
  cookingTime String?
  servings String?
  difficulty String?
  ingredients Json
  instructions Json
  category String?
  featured Boolean @default(false)
  status RecipeStatus @default(DRAFT)
  sortOrder Int @default(0)
  seoTitle String?
  seoDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
  @@index([status,featured,sortOrder])
  @@index([productId,status])
}

model SiteSettings {
  id String @id @default("site")
  businessName String @default("Vijaya Premix")
  brandDescription String @default("Ready-to-cook Indian premixes for convenient home cooking.")
  phone String?
  email String?
  address String?
  whatsappNumber String?
  whatsappMessage String?
  instagramUrl String?
  facebookUrl String?
  youtubeUrl String?
  defaultSiteTitle String @default("Vijaya Premix | Ready-to-Cook Indian Premixes")
  defaultMetaDescription String @default("Ready-to-cook Indian premixes from Vijaya Premix.")
  defaultOgImage String @default("/assets/images/brand/vijaya-premix-logo.jpeg")
  aboutHeading String @default("Authentic flavour. Less kitchen hassle.")
  aboutDescription String @default("Vijaya Premix makes ready-to-cook Indian premixes for convenient home cooking.")
  mission String?
  vision String?
  promiseText String @default("Original branded pack artwork, honest product information, and convenient home cooking.")
  updatedAt DateTime @updatedAt
}

model HomepageSettings {
  id String @id @default("homepage")
  heroEyebrow String?
  heroHeading String @default("Cook Delicious. Cook Instantly.")
  heroDescription String @default("Authentic flavours without the kitchen hassle.")
  heroCtaLabel String @default("Shop Premixes")
  heroCtaUrl String @default("/products")
  heroProductId String?
  showOffer Boolean @default(false)
  showCategories Boolean @default(true)
  showProducts Boolean @default(true)
  showPromise Boolean @default(true)
  showPackToPlate Boolean @default(true)
  showRecipeVideo Boolean @default(true)
  showReviews Boolean @default(true)
  showPreorder Boolean @default(true)
  showGallery Boolean @default(false)
  showNewsletter Boolean @default(false)
  promiseHeading String @default("Our Promise")
  promiseDescription String @default("Authentic flavour made convenient for your kitchen.")
  promiseItems Json @default("[]")
  packToPlateItems Json @default("[]")
  updatedAt DateTime @updatedAt
}

model Review {
  id           String       @id @default(cuid())
  customerName String
  rating       Int
  content      String
  productId    String?
  status       ReviewStatus @default(DRAFT)
  featured     Boolean      @default(false)
  sortOrder    Int          @default(0)
  reviewDate   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, featured, sortOrder])
  @@index([productId, status])
}
